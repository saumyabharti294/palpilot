# Required: Google AI Studio API key — 100% free, no card needed
# Get it at https://aistudio.google.com/apikey (sign in with Google → Create API key)
GOOGLE_API_KEY=

# Optional: PayPal sandbox app credentials (https://developer.paypal.com/dashboard/applications/sandbox)
# Leave blank to run against PalPilot's built-in PayPal simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Public URL of this app (used for PayPal return/cancel URLs and pay links)
APP_URL=http://localhost:3000
PORT=3000

# PalGuard flags any single action at or above this amount as high risk
PALGUARD_LIMIT=500

# Gemini model, then the models to try when it is overloaded or out of free quota
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite

# Password for the merchant dashboard. Required when NODE_ENV=production.
# The browser asks for it once; any username works.
ADMIN_PASSWORD=

# Webhook ID from your PayPal app, needed to receive "invoice paid" events
PAYPAL_WEBHOOK_ID=
